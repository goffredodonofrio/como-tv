[Unit]
Description=Ponte S3 per Como TV (letture a intervalli, contate)
After=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/relay
ExecStart=/usr/bin/python3 /home/ubuntu/relay/relay.py
Restart=always
RestartSec=3
Environment=RELAY_TETTO_GB=80
Environment=RELAY_TETTO_GIORNO_GB=4
[Install]
WantedBy=multi-user.target
