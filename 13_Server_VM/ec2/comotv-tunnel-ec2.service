[Unit]
Description=Tunnel verso la EC2 di Parigi (ponte S3 su 127.0.0.1:8095)
After=network-online.target
[Service]
ExecStart=/usr/bin/ssh -N -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new -i /etc/comotv/ec2-tunnel.key -L 127.0.0.1:8095:127.0.0.1:8095 ubuntu@52.47.187.179
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
