# I fogli partita della redazione (Slack + Drive) -> /var/lib/comotv-fogli/pub,
# servita da nginx su /fogli-redazione/. Un giro e finisce: lo lancia il timer.
# Non e' il ponte delle grafiche: cambiarlo non tocca niente di quello in onda.
# Le chiavi (Slack, account Google) in /etc/comotv-fogli.env, mai nel repo.
[Unit]
Description=Como TV - fogli partita della redazione (Slack e Drive)
After=network-online.target

[Service]
Type=oneshot
User=comotv
Group=comotv
EnvironmentFile=-/etc/comotv-fogli.env
Environment=FOGLI_DIR=/var/lib/comotv-fogli
ExecStart=/usr/bin/node /opt/comotv-fogli/fogli-redazione.js
Nice=15
TimeoutStartSec=20min
