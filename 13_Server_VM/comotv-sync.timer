# Rete di sicurezza: ogni 3 minuti la VM controlla se su GitHub c'è
# qualcosa di nuovo e, solo in quel caso, aggiorna le pagine.
#
# Serve per i push fatti da altrove (Cowork, editor web di GitHub) o
# quando push.command non riesce a raggiungere la macchina.
#
# Installazione:
#   cp comotv-sync.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now comotv-sync.timer

[Unit]
Description=Controllo aggiornamenti pagine Como TV

[Timer]
OnBootSec=2min
OnUnitActiveSec=3min
AccuracySec=30s

[Install]
WantedBy=timers.target
