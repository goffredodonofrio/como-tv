# Il servizio che esporta le grafiche Talent Hunters in file video (PROD).
# Sta accanto al ponte, non dentro: se Chrome si pianta, il ponte non lo sa.
# Codice in 13_Server_VM/esporta; aggiorna.sh NON lo aggiorna: a mano.
[Unit]
Description=Como TV - esporta grafiche in video
After=network-online.target

[Service]
Type=simple
User=comotv
WorkingDirectory=/opt/comotv-esporta
Environment=ESPORTA_PORTA=8090
Environment=ESPORTA_BASE=https://projects-cloud.it/como-tv/live/
Environment=ESPORTA_CHROME=/opt/comotv-esporta/chrome/chrome-headless-shell/linux-153.0.8010.47/chrome-headless-shell-linux64/chrome-headless-shell
Environment=HOME=/opt/comotv-esporta
ExecStart=/usr/bin/node /opt/comotv-esporta/esporta-servizio.js
Restart=on-failure
RestartSec=5
# un esportazione non deve mai portarsi via la macchina delle grafiche
Nice=10
MemoryMax=2G

[Install]
WantedBy=multi-user.target
