# Il servizio che esporta le grafiche Talent Hunters in file video (DEV).
# Sta accanto al ponte, non dentro: se Chrome si pianta, il ponte non lo sa.
# Prod: stessa unita' con porta 8090, base /live/ e cartella /opt/comotv-esporta.
[Unit]
Description=Como TV DEV - esporta grafiche in video
After=network-online.target

[Service]
Type=simple
User=comotv
WorkingDirectory=/opt/comotv-dev-esporta
Environment=ESPORTA_PORTA=8091
Environment=ESPORTA_BASE=https://projects-cloud.it/como-tv-dev/live/
Environment=ESPORTA_CHROME=/opt/comotv-dev-esporta/chrome/chrome-headless-shell/linux-153.0.8010.47/chrome-headless-shell-linux64/chrome-headless-shell
Environment=HOME=/opt/comotv-dev-esporta
ExecStart=/usr/bin/node /opt/comotv-dev-esporta/esporta-servizio.js
Restart=on-failure
RestartSec=5
# un'esportazione non deve mai portarsi via la macchina delle grafiche
Nice=10
MemoryMax=2G

[Install]
WantedBy=multi-user.target
