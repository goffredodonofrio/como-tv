# Lavoro eseguito dal timer: aggiorna le pagine SOLO se su GitHub
# c'è davvero qualcosa di nuovo (altrimenti non tocca niente).

[Unit]
Description=Aggiorna le pagine Como TV se ci sono novità su GitHub
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'cd /var/www/comotv && git fetch -q origin main && if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then echo "novita su GitHub: aggiorno"; /usr/local/bin/comotv-aggiorna; else echo "niente di nuovo"; fi'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=comotv-sync
