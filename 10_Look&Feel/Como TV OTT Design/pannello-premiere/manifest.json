{
  "id": "it.comotv.pannello",
  "name": "Como TV",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "it.comotv.pannello.principale",
      "label": { "default": "Como TV" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["https://projects-cloud.it"]
    }
  }
}
